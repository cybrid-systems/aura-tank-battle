;; Newline-JSON bridge for the HTML client. Node owns the socket and the
;; browser; this process owns the arena and the EDSL evolution gate.
(require "std/string")
(require "std/list")
(require "game/level")
(require "game/arena")
(require "game/evolve")
(require "game/progress")
(require "game/wish")

(define *live-spec* (wish:base "candy"))
(define *wish* '())
(define *buddy-level* 1)

(define (s-get h k d) (if (hash? h) (hash-ref h k d) d))
(define (s-num h k d) (let ((v (s-get h k d))) (if (number? v) v d)))
(define (emit h) (display (json-encode h)) (newline))

(define (web-state req)
  (progress:start *live-spec* (s-num req "seed" 42)))

(define (run-next st req)
  (let ((round (progress:next *live-spec* st (s-num req "seed" 42))))
    (if (not (s-get round "ok" #f))
      (hash "type" "error" "error" (s-get round "why" "not-cleared"))
      (begin
        (set! *live-spec* (s-get round "spec" *live-spec*))
        (state-msg (s-get round "state" st))))))

(define (run-retry st req)
  (let ((round (progress:retry *live-spec* st (s-num req "seed" 42))))
    (if (not (s-get round "ok" #f))
      (hash "type" "error" "error" (s-get round "why" "not-lost"))
      (state-msg (s-get round "state" st)))))

(define (state-msg st)
  (hash "type" "state"
        "protocol" 1
        "state" st
        "level" (edsl:pretty (edsl:form-of *live-spec*))
        "buddy" (hash "name" "小光" "level" *buddy-level*)
        "themes" (wish:themes)))

(define (candidate-msg c)
  (hash "slot" (s-get c "slot" 0)
        "verdict" (s-get c "verdict" "ROLLBACK")
        "fitness" (s-get c "fitness" 0)
        "form" (s-get c "form" "")))

(define (wish-candidate-msg c)
  (let ((spec (s-get c "spec" #f)))
    (hash "slot" (s-get c "slot" 0)
          "verdict" (s-get c "verdict" "ROLLBACK")
          "fitness" (s-get c "fitness" 0)
          "form" (s-get c "form" "")
          "preview" (wish:wire spec))))

(define (run-wish-text req)
  (let* ((text (s-get req "text" ""))
         (seed (s-num req "seed" 1))
         (round (wish:from-text text seed)))
    (if (not (s-get round "ok" #f))
      (hash "type" "error" "error" (s-get round "why" "wish-text-failed"))
      (begin
        (set! *wish* (s-get round "candidates" '()))
        (hash "type" "wish"
              "theme" (s-get round "theme" "candy")
              "label" (s-get round "label" "小世界")
              "source" (s-get round "source" "keywords")
              "heard" (s-get round "heard" "")
              "candidates" (map wish-candidate-msg *wish*))))))

(define (run-wish req)
  (let* ((theme (s-get req "theme" "candy"))
         (seed (s-num req "seed" 1))
         (round (wish:propose theme seed)))
    (if (not (s-get round "ok" #f))
      (hash "type" "error" "error" (s-get round "why" "wish-failed"))
      (begin
        (set! *wish* (s-get round "candidates" '()))
        (hash "type" "wish"
              "theme" theme
              "candidates" (map wish-candidate-msg *wish*))))))

(define (wish-find slot)
  (let loop ((xs *wish*))
    (cond ((not (pair? xs)) #f)
          ((= (s-get (car xs) "slot" -1) slot) (car xs))
          (else (loop (cdr xs))))))

(define (run-keep st req)
  (let* ((slot (s-num req "slot" -1))
         (cand (wish-find slot)))
    (if (not (and cand (equal? (s-get cand "verdict" "") "KEEP")))
      (hash "type" "error" "error" "wish-not-kept")
      (let ((spec (s-get cand "spec" #f)))
        (if (not (hash? spec))
          (hash "type" "error" "error" "wish-no-spec")
          (begin
            (set! *live-spec* spec)
            (set! *buddy-level* (+ *buddy-level* 1))
            (state-msg (web-state req))))))))

(define (run-evolve st req)
  (let* ((round (tank-evo:evolve *live-spec* (s-num req "seed" 42)))
         (keep (equal? (s-get round "verdict" "") "KEEP"))
         (won (s-get round "spec" *live-spec*))
         (next (if keep
                 (begin (set! *live-spec* won) (web-state req))
                 st)))
    (hash "type" "evolve"
          "protocol" 1
          "verdict" (s-get round "verdict" "ROLLBACK")
          "baseline" (s-get (s-get round "baseline" (hash)) "fitness" 0)
          "candidates" (map candidate-msg (s-get round "candidates" '()))
          "form" (if keep (s-get round "winner" "")
                    (edsl:pretty (edsl:form-of *live-spec*)))
          "state" next)))

(define (run-request req st)
  (let ((cmd (s-get req "cmd" "")))
    (cond
      ((equal? cmd "tick")
       (state-msg (arena:step st (s-get req "input" (hash)))))
      ((equal? cmd "new")
       (state-msg (web-state req)))
      ((equal? cmd "next")
       (run-next st req))
      ((equal? cmd "retry")
       (run-retry st req))
      ((equal? cmd "evolve")
       (run-evolve st req))
      ((equal? cmd "wish")
       (run-wish req))
      ((equal? cmd "wish-text")
       (run-wish-text req))
      ((equal? cmd "keep")
       (run-keep st req))
      ((equal? cmd "ping")
       (hash "type" "pong" "protocol" 1))
      (else (hash "type" "error" "error" "unknown-command")))))

(define (serve st)
  (let ((line (read-line)))
    (if (eof-object? line)
      #t
      (let ((req (try (json-parse line) (catch (e) #f))))
        (if (not (hash? req))
          (begin
            (emit (hash "type" "error" "error" "bad-json"))
            (serve st))
          (let ((reply (try (run-request req st)
                            (catch (e) (hash "type" "error" "error" "tank-error")))))
            (emit reply)
            (serve (s-get reply "state" st))))))))

(serve (web-state (hash)))

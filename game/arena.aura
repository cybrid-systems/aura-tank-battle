;; Headless tank-battle state machine for the #23 frame contract. Pure
;; integer grid, fixed seed, no renderer and no target hooks. The state
;; shape is exactly what lib/game/assert.aura evaluates each frame.

(require "std/string")
(require "std/list")

(export arena:new arena:step arena:help)

(define (arena:help)
  (string-append
    "Arena: (arena:new opts) -> state; (arena:step state input) -> next state with events. "
    "opts: seed, levels, tuning (player-speed, fire-cooldown, enemy-cooldown, enemy-score)."))

(define (a-get h k d) (if (hash? h) (hash-ref h k d) d))
(define (a-num h k d) (let ((v (a-get h k d))) (if (number? v) v d)))

(define (a-copy h)
  (let ((out (hash)))
    (for-each (lambda (k) (hash-set! out k (hash-ref h k))) (hash-keys h))
    out))

(define (a-with h k v)
  (let ((c (a-copy h))) (hash-set! c k v) c))

(define (a-event st e)
  (a-with st "events" (cons e (a-get st "events" '()))))

(define (a-out? x y)
  (or (< x 0) (>= x 13) (< y 0) (>= y 13)))

(define (a-tile? tiles x y)
  (let loop ((xs tiles))
    (cond ((not (pair? xs)) #f)
          ((and (= (a-num (car xs) "x" -1) x)
                (= (a-num (car xs) "y" -1) y)) #t)
          (else (loop (cdr xs))))))

(define (a-remove-tile tiles x y)
  (filter (lambda (t) (not (and (= (a-num t "x" -1) x)
                                (= (a-num t "y" -1) y))))
          tiles))

(define (a-enemy-at? enemies x y)
  (let loop ((xs enemies))
    (cond ((not (pair? xs)) #f)
          ((and (= (a-num (car xs) "x" -1) x)
                (= (a-num (car xs) "y" -1) y)) #t)
          (else (loop (cdr xs))))))

(define (a-remove-enemy enemies x y)
  (filter (lambda (e) (not (and (= (a-num e "x" -1) x)
                                (= (a-num e "y" -1) y))))
          enemies))

; Level 1 enemies are the three originals. Later levels add one center
; enemy and start the others with different fire cooldowns, so a replay of
; the same input script does not depend on wall-clock time.
(define (a-enemies-for level)
  (if (>= level 2)
    (list (hash "x" 1 "y" 0 "cooldown" 4)
          (hash "x" 6 "y" 0 "cooldown" 2)
          (hash "x" 11 "y" 0 "cooldown" 5))
    (list (hash "x" 1 "y" 0 "cooldown" 3)
          (hash "x" 6 "y" 0 "cooldown" 2)
          (hash "x" 11 "y" 0 "cooldown" 4))))

; Compatibility for the frame checks that only need the level-1 spawn.
(define (a-enemies)
  (a-enemies-for 1))

; Level layouts. The base is always (6,12); the shield, steel and water
; differ. arena:new uses level 1; a clear loads the next layout in place.
(define (a-layout level)
  (if (>= level 2)
    (hash "bricks" (list (hash "x" 5 "y" 10) (hash "x" 6 "y" 10)
                         (hash "x" 7 "y" 10) (hash "x" 5 "y" 11)
                         (hash "x" 7 "y" 11) (hash "x" 3 "y" 7)
                         (hash "x" 4 "y" 7) (hash "x" 8 "y" 6)
                         (hash "x" 9 "y" 6))
          "steel" (list (hash "x" 2 "y" 6) (hash "x" 10 "y" 9))
          "water" (list (hash "x" 8 "y" 8) (hash "x" 9 "y" 8)))
    (hash "bricks" (list (hash "x" 5 "y" 10) (hash "x" 6 "y" 10)
                         (hash "x" 7 "y" 10) (hash "x" 5 "y" 11)
                         (hash "x" 7 "y" 11))
          "steel" (list (hash "x" 2 "y" 6))
          "water" (list (hash "x" 8 "y" 8)))))

(define (a-player-x st) (a-num (a-get st "player" (hash)) "x" -1))
(define (a-player-y st) (a-num (a-get st "player" (hash)) "y" -1))
(define (a-base st) (a-get st "base" (hash "x" 6 "y" 12)))
(define (a-base-x st) (a-num (a-base st) "x" 6))
(define (a-base-y st) (a-num (a-base st) "y" 12))

(define (a-blocked? st x y)
  (or (a-out? x y)
      (a-tile? (a-get st "bricks" '()) x y)
      (a-tile? (a-get st "steel" '()) x y)
      (a-tile? (a-get st "water" '()) x y)
      (a-enemy-at? (a-get st "enemies" '()) x y)
      (and (= x (a-base-x st)) (= y (a-base-y st)))))

(define (a-water? st x y)
  (a-tile? (a-get st "water" '()) x y))

; A blocked move still turns the hull, so the next shot goes where the
; player pointed.
(define (a-facing st dir)
  (a-with st "player" (hash "x" (a-player-x st) "y" (a-player-y st) "dir" dir)))

(define (a-face st input)
  (let ((face (a-get input "face" #f)))
    (if (and (string? face)
             (member? face (list "up" "down" "left" "right")))
      (a-facing st face)
      st)))

(define (a-move-step st move)
  (let* ((x (a-player-x st)) (y (a-player-y st))
         (nx (cond ((equal? move "right") (+ x 1))
                   ((equal? move "left") (- x 1)) (else x)))
         (ny (cond ((equal? move "down") (+ y 1))
                   ((equal? move "up") (- y 1)) (else y))))
    (cond
      ((a-out? nx ny) (a-event (a-facing st move) "blocked"))
      ((a-water? st nx ny) (a-event (a-facing st move) "blocked-water"))
      ((a-blocked? st nx ny) (a-event (a-facing st move) "blocked"))
      (else (a-with st "player" (hash "x" nx "y" ny "dir" move))))))

(define (a-move st input)
  (if (not (equal? (a-get st "status" "") "playing"))
    st
    (let ((move (a-get input "move" #f)))
      (if (not (and (string? move) (> (string-length move) 0)))
        st
        (let ((speed (max 1 (a-num (a-get st "tuning" (hash)) "player-speed" 1))))
          (let loop ((k speed) (s st))
            (if (<= k 0) s (loop (- k 1) (a-move-step s move)))))))))

(define (a-front st)
  (let* ((p (a-get st "player" (hash)))
         (x (a-num p "x" 4))
         (y (a-num p "y" 12))
         (dir (a-get p "dir" "up")))
    (list (cond ((equal? dir "left") (- x 1))
                ((equal? dir "right") (+ x 1))
                (else x))
          (cond ((equal? dir "up") (- y 1))
                ((equal? dir "down") (+ y 1))
                (else y)))))

(define (a-fire st input)
  (if (not (equal? (a-get st "status" "") "playing"))
    st
    (let* ((cool (a-num st "cooldown" 0))
           (front (a-front st))
           (fx (car front)) (fy (car (cdr front)))
           (dir (a-get (a-get st "player" (hash)) "dir" "up"))
           (cd (a-num (a-get st "tuning" (hash)) "fire-cooldown" 3))
           (firing (and (equal? (a-get input "fire" #f) #t) (<= cool 0))))
      (cond
        ((not firing) (a-with st "cooldown" (max 0 (- cool 1))))
        ((a-out? fx fy) (a-with (a-event st "fired") "cooldown" cd))
        ; A wall directly in front is the shot: the player can clear the
        ; base shield instead of being unable to reach the lane behind it.
        ((a-tile? (a-get st "bricks" '()) fx fy)
         (a-with
           (a-event (a-with st "bricks"
                            (a-remove-tile (a-get st "bricks" '()) fx fy))
                    "bullet-hit-brick")
           "cooldown" cd))
        ((a-tile? (a-get st "steel" '()) fx fy)
         (a-with (a-event st "bullet-hit-steel") "cooldown" cd))
        ((and (= fx (a-base-x st)) (= fy (a-base-y st)))
         (a-with (a-event st "base-blocked") "cooldown" cd))
        ((a-enemy-at? (a-get st "enemies" '()) fx fy)
         (a-with
           (a-event
             (a-with (a-with st "enemies"
                             (a-remove-enemy (a-get st "enemies" '()) fx fy))
                     "score" (+ (a-num (a-get st "tuning" (hash)) "enemy-score" 100)
                                (a-num st "score" 0)))
             "enemy-destroy")
           "cooldown" cd))
        (else
         (a-with
           (a-event
             (a-with st "bullets"
                     (cons (hash "x" fx "y" fy "dir" dir "owner" "player")
                           (a-get st "bullets" '())))
             "fired")
           "cooldown" cd))))))

(define (a-step-bullet st b)
  (let* ((x (a-num b "x" -1)) (y (a-num b "y" -1))
         (dir (a-get b "dir" "up"))
         (nx (cond ((equal? dir "right") (+ x 1))
                   ((equal? dir "left") (- x 1)) (else x)))
         (ny (cond ((equal? dir "down") (+ y 1))
                   ((equal? dir "up") (- y 1)) (else y)))
         (owner (a-get b "owner" "player")))
    (cond
      ((a-out? nx ny) st)
      ((a-tile? (a-get st "bricks" '()) nx ny)
       (a-event (a-with st "bricks" (a-remove-tile (a-get st "bricks" '()) nx ny))
                "bullet-hit-brick"))
      ((a-tile? (a-get st "steel" '()) nx ny)
       (a-event st "bullet-hit-steel"))
      ((and (= nx (a-base-x st)) (= ny (a-base-y st)))
       (if (equal? owner "enemy")
         (a-event (a-with st "status" "lost") "base-destroyed")
         (a-event st "base-blocked")))
      ; Only the player scores a kill; an enemy round passes through
      ; another enemy instead of trading the board for free points.
      ((and (equal? owner "player")
            (a-enemy-at? (a-get st "enemies" '()) nx ny))
       (a-event (a-with (a-with st "enemies"
                                (a-remove-enemy (a-get st "enemies" '()) nx ny))
                        "score" (+ (a-num (a-get st "tuning" (hash)) "enemy-score" 100)
                                   (a-num st "score" 0)))
                "enemy-destroy"))
      ((and (equal? owner "enemy")
            (= nx (a-player-x st)) (= ny (a-player-y st)))
       (if (> (a-num st "shield" 0) 0)
         (a-event st "shielded")
         (let* ((lives (max 0 (- (a-num st "lives" 1) 1)))
                (status (if (= lives 0) "lost" "playing"))
                (next (a-with (a-with (a-with st "lives" lives) "status" status)
                              "player" (hash "x" 4 "y" 12 "dir" "up"))))
           (a-event (if (= lives 0) next (a-with next "shield" 30))
                    "player-hit"))))
      (else
       (a-with st "bullets"
               (cons (a-with (a-with b "x" nx) "y" ny) (a-get st "bullets" '())))))))

(define (a-run-bullets st)
  (let loop ((xs (a-get st "bullets" '())) (acc (a-with st "bullets" '())))
    (if (not (pair? xs))
      acc
      (loop (cdr xs) (a-step-bullet acc (car xs))))))

; Enemy patrol: walk toward the base column, then down. A blocked
; horizontal step falls back to a downward step; a brick/steel/water cell
; stops the enemy there and its gun does the work. Enemies never enter the
; player or base cell and never stack on one another.
(define (a-enemy-can? st x y)
  (and (not (a-out? x y))
       (not (a-tile? (a-get st "bricks" '()) x y))
       (not (a-tile? (a-get st "steel" '()) x y))
       (not (a-tile? (a-get st "water" '()) x y))
       (not (a-enemy-at? (a-get st "enemies" '()) x y))
       (not (and (= x (a-player-x st)) (= y (a-player-y st))))
       (not (and (= x (a-base-x st)) (= y (a-base-y st))))))

(define (a-enemy-move st e)
  (let* ((x (a-num e "x" 0)) (y (a-num e "y" 0))
         (hx (cond ((< x (a-base-x st)) 1)
                   ((> x (a-base-x st)) -1)
                   (else 0)))
         (dy (if (< y (a-base-y st)) 1 0))
         (ny (+ y dy))
         (moved
           (cond
             ((and (not (= hx 0)) (a-enemy-can? st (+ x hx) y))
              (a-with e "x" (+ x hx)))
             ((and (= hx 0) (= dy 1) (a-enemy-can? st x ny))
              (a-with e "y" ny))
             ((and (not (= hx 0)) (= dy 1) (a-enemy-can? st x ny))
              (a-with e "y" ny))
             (else e))))
    moved))

; Fire when the barrel points down a lane the base or player occupies.
; The cooldown is per enemy and ticks down on every enemy action.
(define (a-enemy-act st e)
  (let* ((moved (a-enemy-move st e))
         (x (a-num moved "x" 0))
         (y (a-num moved "y" 0))
         (cool (a-num moved "cooldown" 0))
         (aim (or (= x (a-base-x st)) (= x (a-player-x st))))
         (st2 (if (and aim (<= cool 0) (< y 12))
                (a-event
                  (a-step-bullet st (hash "x" x "y" y "dir" "down"
                                          "owner" "enemy"))
                  "enemy-fired")
                st)))
    (hash "state" st2
          "enemy" (if (and aim (<= cool 0) (< y 12))
                    (a-with moved "cooldown"
                              (a-num (a-get st "tuning" (hash)) "enemy-cooldown" 6))
                    (a-with moved "cooldown" (max 0 (- cool 1)))))))

(define (a-enemies-step st)
  (let ((pace (max 1 (a-num (a-get st "tuning" (hash)) "enemy-pace" 1))))
    (if (or (not (equal? (a-get st "status" "") "playing"))
            (not (= 0 (remainder (a-num st "tick" 1) pace))))
      st
      (let loop ((xs (a-get st "enemies" '())) (cur st) (acc '()))
        (if (not (pair? xs))
          (a-with cur "enemies" (reverse acc))
          (let* ((one (a-enemy-act cur (car xs)))
                 (moved (a-get one "enemy" (car xs)))
                 (next (a-get one "state" cur))
                 (next (a-with next "enemies"
                               (append (reverse acc) (cons moved (cdr xs))))))
            (loop (cdr xs) next (cons moved acc))))))))

(define (a-clear st)
  (if (not (equal? (a-get st "status" "") "playing"))
    st
    (if (pair? (a-get st "enemies" '()))
      st
      (let* ((level (a-num st "level" 1))
             (levels (a-num st "levels" 2))
             (next (+ level 1))
             (layout (a-layout next)))
        (cond
          ((< level levels)
           (a-event
             (a-event
               (a-with
                 (a-with
                   (a-with
                     (a-with (a-with st "level" next)
                             "enemies" (a-enemies-for next))
                     "bricks" (a-get layout "bricks" '()))
                   "steel" (a-get layout "steel" '()))
                 "water" (a-get layout "water" '()))
               "enemies-cleared")
             "enemy-spawn"))
          (else (a-event (a-with st "status" "won") "enemies-cleared")))))))

(define (a-tune-merge base extra)
  (let ((out (a-copy base)))
    (if (hash? extra)
      (for-each (lambda (k) (hash-set! out k (hash-ref extra k)))
                (hash-keys extra))
      #f)
    out))

(define (arena:new opts)
  (let* ((players (a-num opts "players" 1))
         (levels (a-num opts "levels" 2))
         (spec (a-get opts "spec" #f))
         (layout (a-layout 1))
         (tuning (a-tune-merge
                   (if (hash? spec) (a-get spec "tuning" (hash)) (hash))
                   (a-get opts "tuning" (hash)))))
    (hash "player" (hash "x" 4 "y" 12 "dir" "up")
          "tuning" tuning
          "tick" 0 "bullets" '() "cooldown" 0
          "bricks" (a-get opts "bricks"
                          (if (hash? spec) (a-get spec "bricks" '())
                              (a-get layout "bricks" '())))
          "steel" (a-get opts "steel"
                         (if (hash? spec) (a-get spec "steel" '())
                             (a-get layout "steel" '())))
          "water" (a-get opts "water"
                         (if (hash? spec) (a-get spec "water" '())
                             (a-get layout "water" '())))
          "base" (hash "x" 6 "y" 12)
          "enemies" (a-enemies-for 1)
          "score" 0 "lives" 3 "level" 1 "levels" levels
          "seed" (a-num opts "seed" 0) "shield" 0
          "level_name" (if (hash? spec) (a-get spec "name" "custom") "courtyard")
          "status" "playing" "frame_ms" 0 "visual_diff_ok" #t
          "players" players "events" '())))

(define (arena:step state input)
  (let* ((t0 (monotonic-ms))
         (st (a-with (a-with state "tick" (+ 1 (a-num state "tick" 0))) "events" '()))
         (st (a-with (a-with st "frame_ms" 0) "visual_diff_ok" #t))
         (st (a-with st "shield" (max 0 (- (a-num st "shield" 0) 1))))
         (st (a-face st input))
         (st (a-move st input))
         (st (a-fire st input))
         (st (a-run-bullets st))
         (st (a-enemies-step st))
         (st (a-clear st))
         (dt (- (monotonic-ms) t0)))
    (a-with st "frame_ms" (max 0 dt))))

;; Kid-facing wish boxes. A theme is a starting EDSL form; each wish asks
;; the same evo:trial gate as the developer panel, and only a fair family is
;; offered back to the child.
(require "std/string")
(require "std/list")
(require "std/llm" all:)
(require "game/level")
(require "game/evolve")

(export wish:themes wish:base wish:propose wish:custom wish:from-text
        wish:keywords wish:wire wish:help)

(define (wish:help)
  "Wish: (wish:themes) -> stickers; (wish:propose theme seed) -> three trials; (wish:from-text text seed) -> an interpreted wish.")

(define (wish-shield)
  (list (list 5 10) (list 6 10) (list 7 10) (list 5 11) (list 7 11)))

(define (wish-pairs xs)
  (map (lambda (p) (list (car p) (car (cdr p)))) xs))

(define (wish-form name bricks steel water cooldown)
  (list 'level
        (list 'name (string->symbol name))
        (cons 'bricks (wish-pairs bricks))
        (cons 'steel (wish-pairs steel))
        (cons 'water (wish-pairs water))
        (list 'tuning
              (list 'player-speed 1)
              (list 'fire-cooldown 3)
              (list 'enemy-cooldown cooldown)
              (list 'enemy-score 100))))

(define (wish-data id)
  (cond
    ((equal? id "candy")
     (hash "label" "糖果世界" "emoji" "🍭" "bricks" (append (wish-shield) (list (list 3 8) (list 9 8)))
           "steel" (list (list 2 5)) "water" (list (list 4 10) (list 8 10))
           "cooldown" 8))
    ((equal? id "dino")
     (hash "label" "恐龙乐园" "emoji" "🦕" "bricks" (append (wish-shield) (list (list 2 7) (list 10 7)))
           "steel" (list (list 3 4) (list 9 4)) "water" (list (list 4 6) (list 8 6))
           "cooldown" 7))
    ((equal? id "space")
     (hash "label" "太空基地" "emoji" "🚀" "bricks" (append (wish-shield) (list (list 4 5) (list 8 5)))
           "steel" (list (list 2 7) (list 10 7)) "water" '()
           "cooldown" 9))
    ((equal? id "ocean")
     (hash "label" "海底泡泡" "emoji" "🐠" "bricks" (append (wish-shield) (list (list 4 9) (list 8 9)))
           "steel" (list (list 2 5) (list 10 5)) "water" (list (list 5 7) (list 7 7))
           "cooldown" 7))
    ((equal? id "rainbow")
     (hash "label" "彩虹云朵" "emoji" "🌈" "bricks" (append (wish-shield) (list (list 3 6) (list 9 6)))
           "steel" (list (list 2 9) (list 10 9)) "water" (list (list 4 7) (list 8 7))
           "cooldown" 6))
    (else #f)))

(define (wish:themes)
  (map (lambda (id)
         (let ((d (wish-data id)))
           (hash "id" id "label" (hash-ref d "label") "emoji" (hash-ref d "emoji"))))
       (list "candy" "dino" "space" "ocean" "rainbow")))

(define (wish:base id)
  (let ((d (wish-data id)))
    (if (not (hash? d))
      (hash "ok" #f "why" "unknown-theme")
      (edsl:compile (wish-form id (hash-ref d "bricks")
                               (hash-ref d "steel")
                               (hash-ref d "water")
                               (hash-ref d "cooldown"))))))

; ── Text and voice wishes (#LLM) ───────────────────────────────
; The model never writes code. It returns a small JSON hint: theme plus a
; few optional water/brick cells. The same EDSL validator and evo:trial
; gate then decide what the child sees.

(define (wish-cell-ok? x y)
  (and (number? x) (number? y)
       (>= x 0) (< x 13) (>= y 0) (< y 13)
       (not (and (= x 4) (= y 12)))
       (not (and (= x 6) (= y 12)))
       (not (or (and (= x 1) (= y 0))
                (and (= x 6) (= y 0))
                (and (= x 11) (= y 0))))))

(define (wish-take xs n)
  (let loop ((ys xs) (k 0) (acc '()))
    (if (or (not (pair? ys)) (>= k n))
      (reverse acc)
      (loop (cdr ys) (+ k 1) (cons (car ys) acc)))))

(define (wish-coords data key)
  (let ((v (if (hash? data) (hash-ref data key #f) #f)))
    (if (not (pair? v))
      '()
      (wish-take
        (filter (lambda (p)
                  (and (pair? p)
                       (pair? (cdr p))
                       (wish-cell-ok? (car p) (car (cdr p)))))
                v)
        4))))

(define (wish-spec-like spec bricks steel water)
  (hash "ok" #t
        "name" (hash-ref spec "name" "custom")
        "bricks" bricks "steel" steel "water" water
        "tuning" (hash-ref spec "tuning" (hash))))

(define (wish:keywords text)
  (let ((s (string-downcase (if (string? text) text ""))))
    (cond
      ((or (string-contains? s "糖果") (string-contains? s "糖")
           (string-contains? s "candy") (string-contains? s "甜"))
       "candy")
      ((or (string-contains? s "恐龙") (string-contains? s "dino")
           (string-contains? s "龙"))
       "dino")
      ((or (string-contains? s "太空") (string-contains? s "space")
           (string-contains? s "星球") (string-contains? s "星"))
       "space")
      ((or (string-contains? s "海底") (string-contains? s "海")
           (string-contains? s "水") (string-contains? s "ocean")
           (string-contains? s "鱼"))
       "ocean")
      ((or (string-contains? s "彩虹") (string-contains? s "rainbow")
           (string-contains? s "云"))
       "rainbow")
      (else "candy"))))

(define (wish-last-index s ch)
  (let loop ((i 0) (last -1))
    (if (>= i (string-length s))
      last
      (loop (+ i 1) (if (= (string-ref s i) ch) i last)))))

(define (wish-json-content content)
  (let* ((s (string-trim content))
         (start (string-find s "{"))
         (end (wish-last-index s 125)))
    (if (and (>= start 0) (> end start))
      (substring s start (+ end 1))
      s)))

(define wish-llm-system
  (string-append
    "You translate a young child's tank-game wish into JSON only. "
    "Pick theme from candy,dino,space,ocean,rainbow. "
    "Optional water and bricks are arrays of [x,y] grid cells, 0..12, at most 4 each. "
    "Never use the player (4,12), base (6,12), or enemy spawns (1,0),(6,0),(11,0). "
    "Return one object: {\"theme\":\"...\",\"label\":\"...\","
    "\"water\":[[x,y]],\"bricks\":[[x,y]]}. No prose, no code fences."))

(define (wish:ask-llm text)
  (if (not (and (string? text) (> (string-length text) 0)))
    #f
    (let* ((reply (try (llm:chat wish-llm-system text
                                  (hash "max_tokens" 900 "temperature" 0.2)
                                  40)
                       (catch (e) #f)))
           (content (if (hash? reply) (hash-ref reply "content" #f) #f)))
      (if (not (and (string? content) (> (string-length content) 0)))
        #f
        (let* ((data (try (json-parse (wish-json-content content))
                          (catch (e) #f)))
               (theme (if (hash? data) (hash-ref data "theme" "") "")))
          (if (not (and (string? theme) (hash? (wish-data theme))))
            #f
            (let ((label (hash-ref data "label" "")))
              (hash "theme" theme
                    "label" (if (and (string? label) (> (string-length label) 0))
                              label
                              (hash-ref (wish-data theme) "label" "小世界"))
                    "water" (wish-coords data "water")
                    "bricks" (wish-coords data "bricks")))))))))

(define (wish:custom theme extras seed)
  (let* ((base (wish:base theme))
         (ok (and (hash? base) (hash-ref base "ok" #f)))
         (label (if (and (hash? extras) (string? (hash-ref extras "label" #f)))
                  (hash-ref extras "label")
                  (if (hash? (wish-data theme))
                    (hash-ref (wish-data theme) "label" "小世界")
                    "小世界")))
         (extra-b (if (hash? extras) (hash-ref extras "bricks" '()) '()))
         (extra-w (if (hash? extras) (hash-ref extras "water" '()) '()))
         (merged (if ok
                   (wish-spec-like
                     base
                     (append (map (lambda (p) (hash "x" (car p) "y" (car (cdr p)))) extra-b)
                             (hash-ref base "bricks" '()))
                     (hash-ref base "steel" '())
                     (append (map (lambda (p) (hash "x" (car p) "y" (car (cdr p)))) extra-w)
                             (hash-ref base "water" '())))
                   base))
         (checked (if (hash? merged) (edsl:compile (edsl:form-of merged)) base))
         (final (if (and (hash? checked) (hash-ref checked "ok" #f)) checked base)))
    (if (not (and (hash? final) (hash-ref final "ok" #f)))
      (hash "ok" #f "why" (if (hash? final) (hash-ref final "why" "bad-wish") "bad-wish"))
      (let ((specs (list final
                         (tank-evo:mutate final (+ seed 1) 1 theme)
                         (tank-evo:mutate final (+ seed 2) 2 theme))))
        (hash "ok" #t "theme" theme "label" label
              "candidates" (wish-trials specs seed))))))

(define (wish:from-text text seed)
  (let* ((llm (wish:ask-llm text))
         (fallback (wish:keywords text))
         (theme (if (hash? llm) (hash-ref llm "theme" fallback) fallback))
         (round (wish:custom theme (if (hash? llm) llm (hash)) seed))
         (round2 (if (hash-ref round "ok" #f)
                   round
                   (wish:custom fallback (hash) seed))))
    (if (hash-ref round2 "ok" #f)
      (hash "ok" #t
            "theme" (hash-ref round2 "theme" theme)
            "label" (hash-ref round2 "label" "小世界")
            "source" (if (hash? llm) "llm" "keywords")
            "heard" (if (string? text) text "")
            "candidates" (hash-ref round2 "candidates" '()))
      round2)))

(define (wish-trials specs seed)
  (let loop ((xs specs) (slot 0) (acc '()))
    (if (not (pair? xs))
      (reverse acc)
      (loop (cdr xs) (+ slot 1)
            (cons (tank-evo:trial (car xs) (+ seed slot) slot) acc)))))

(define (wish:propose id seed)
  (let* ((base (wish:base id))
         (ok (and (hash? base) (hash-ref base "ok" #f))))
    (if (not ok)
      (hash "ok" #f "why" (if (hash? base) (hash-ref base "why" "bad-theme") "unknown-theme"))
      (let ((specs (list base
                         (tank-evo:mutate base (+ seed 1) 1 id)
                         (tank-evo:mutate base (+ seed 2) 2 id))))
        (hash "ok" #t "theme" id "base" base
              "candidates" (wish-trials specs seed))))))

; Compact wire hash for the browser's mini preview.
(define (wish:wire spec)
  (if (not (hash? spec))
    (hash)
    (hash "name" (hash-ref spec "name" "custom")
          "bricks" (hash-ref spec "bricks" '())
          "steel" (hash-ref spec "steel" '())
          "water" (hash-ref spec "water" '())
          "tuning" (hash-ref spec "tuning" (hash)))))

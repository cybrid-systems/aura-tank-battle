;; Endless level handoff through game/progress.aura.
(require "std/string")
(require "std/list")
(require "game/level")
(require "game/progress")

(define (line k v) (display k) (display "=") (display v) (newline))
(define (copy h)
  (let ((out (hash)))
    (for-each (lambda (k) (hash-set! out k (hash-ref h k))) (hash-keys h))
    out))

(define spec (edsl:compile (edsl:default)))
(define start (progress:start spec 7))
(line "start-level" (hash-ref start "level"))
(line "start-difficulty" (hash-ref start "difficulty"))
(line "start-tanks" (length (hash-ref start "enemies")))

(define cleared (let ((c (copy start)))
                  (hash-set! c "enemies" '())
                  (hash-set! c "status" "cleared")
                  (hash-set! c "score" 450)
                  (hash-set! c "lives" 2)
                  c))
(define next (progress:next spec cleared 7))
(line "next-ok" (hash-ref next "ok" #f))
(line "next-level" (hash-ref (hash-ref next "state" (hash)) "level"))
(line "next-difficulty" (hash-ref (hash-ref next "state" (hash)) "difficulty"))
(line "next-tanks" (length (hash-ref (hash-ref next "state" (hash)) "enemies")))
(line "next-score" (hash-ref (hash-ref next "state" (hash)) "score"))
(line "next-lives" (hash-ref (hash-ref next "state" (hash)) "lives"))
(line "next-verdict" (hash-ref next "verdict"))

(define lost (let ((c (copy start)))
               (hash-set! c "status" "lost")
               (hash-set! c "difficulty" 2)
               (hash-set! c "score" 300)
               c))
(define retry (progress:retry spec lost 7))
(line "retry-ok" (hash-ref retry "ok" #f))
(line "retry-level" (hash-ref (hash-ref retry "state" (hash)) "level"))
(line "retry-difficulty" (hash-ref (hash-ref retry "state" (hash)) "difficulty"))
(line "retry-tanks" (length (hash-ref (hash-ref retry "state" (hash)) "enemies")))
(line "retry-lives" (hash-ref (hash-ref retry "state" (hash)) "lives"))
(line "retry-score" (hash-ref (hash-ref retry "state" (hash)) "score"))
